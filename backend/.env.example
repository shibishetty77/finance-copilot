# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Finance Copilot"
APP_ENV=development              # development | staging | production
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/financecopilot

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI ───────────────────────────────────────────────────────────────────────
# Provider: "gemini" | "openai" | "claude"
AI_PROVIDER=gemini

# Model to use (must match a model ID for the selected provider)
MODEL_NAME=gemini-2.5-flash

# Generation parameters
TEMPERATURE=0.2
MAX_TOKENS=2048

# Provider API keys — never expose these to the frontend
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=                         # reserved for future use

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=200
AUTH_RATE_LIMIT_PER_MINUTE=10
