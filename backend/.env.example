# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="CortexFi"
APP_ENV=development              # development | staging | production
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/cortexfi

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI ───────────────────────────────────────────────────────────────────────
# Provider: "gemini" | "openai" | "claude"
AI_PROVIDER=gemini

# ─── OCR ──────────────────────────────────────────────────────────────────────
# Full path to the Tesseract executable. If not set, relies on the system PATH.
# Example for Windows:
# TESSERACT_CMD=C:\Users\Shibi R Shetty\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Model to use (must match a model ID for the selected provider)
MODEL_NAME=gemini-2.5-flash

# Generation parameters
TEMPERATURE=0.2
MAX_TOKENS=2048

# Provider API keys — never expose these to the frontend
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=                         # reserved for future use

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=200
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5173/gmail-callback

# ─── Market Data APIs ────────────────────────────────────────────────────────
# These APIs provide real-time market data to prevent AI hallucination
# Frankfurter (Forex) - Free, no API key required
# CoinGecko (Crypto) - Free tier available, API key optional for higher limits
COINGECKO_API_KEY=
# Twelve Data (Stocks/Forex/Commodities) - API key required for production
TWELVE_DATA_API_KEY=
